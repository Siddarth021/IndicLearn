# IndicLearn Studio configuration (all optional - the defaults run fully offline)
INDICLEARN_DATA_DIR=data/studio
INDICLEARN_MAX_UPLOAD_MB=40
INDICLEARN_MAX_DOCS=25
INDICLEARN_TOKEN_TTL_DAYS=30
INDICLEARN_ALLOW_GUEST=true
INDICLEARN_ALLOW_REGISTRATION=true
INDICLEARN_CORS_ORIGINS=

# ---------------------------------------------------------------------------------------------
# Hybrid AI tutor (detailed explanations in Telugu/Hindi/..., reasoning, translation, smart map)
# Copy this file to .env and fill in ONE key. Without any key the app stays fully offline and
# quotes answers from the notes (the old behaviour).
#   Order tried: hosted keys below -> local Ollama (offline LLM) -> extractive answers.
#   INDICLEARN_BRAIN=auto | off | a comma list such as  sarvam,gemini,ollama
# Privacy: with a hosted key, the question and the matching passages of the notes are sent to
# that provider. Use INDICLEARN_BRAIN=ollama to keep everything on this computer.
# ---------------------------------------------------------------------------------------------
INDICLEARN_BRAIN=auto
INDICLEARN_GEMINI_API_KEY=                 # https://aistudio.google.com/apikey
INDICLEARN_GEMINI_API_KEY_2=               # optional: a key from a SECOND Google account = double the free quota (_3 ... _9 also work)
INDICLEARN_GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash,gemini-flash-latest,gemini-2.5-flash   # free tier ~20 req/day PER model: rotated
INDICLEARN_SARVAM_API_KEY=                 # https://dashboard.sarvam.ai (Indic-first models; also powers the mic and voice)
INDICLEARN_SARVAM_MODEL=sarvam-105b
INDICLEARN_OPENAI_BASE_URL=                # any OpenAI-compatible server (OpenRouter, Groq, LM Studio...)
INDICLEARN_OPENAI_API_KEY=
INDICLEARN_OPENAI_MODEL=
INDICLEARN_ANTHROPIC_API_KEY=
INDICLEARN_ANTHROPIC_MODEL=claude-haiku-5-5
INDICLEARN_BRAIN_TIMEOUT=45
INDICLEARN_HOSTED_SPEECH=on                # off = keep audio on this computer (offline Whisper / MMS voices)

# ---------------------------------------------------------------------------------------------
# OFFLINE mode - works with no key and no internet. One-time setup:  python scripts/setup_offline.py
# Used automatically whenever no key is set or the hosted provider/internet is down.
# ---------------------------------------------------------------------------------------------
INDICLEARN_OLLAMA=on                       # local LLM through Ollama (https://ollama.com) - off to disable
INDICLEARN_LLM_MODEL=gemma4:e2b            # gemma4:e4b = better answers, slower on a 4 GB GPU
INDICLEARN_OLLAMA_URL=http://127.0.0.1:11434
INDICLEARN_OLLAMA_TIMEOUT=180
INDICLEARN_OLLAMA_CTX=8192
INDICLEARN_AUX_DEVICE=auto                 # auto | cpu | cuda  (auto: helper models on CPU when the GPU is < 8 GB)
INDICLEARN_EMBEDDING_BACKEND=auto          # auto = use models/pretrained/e5_small if present | none | sentence_transformers
INDICLEARN_EMBEDDING_MODEL=intfloat/multilingual-e5-small
INDICLEARN_TRANSLATOR_BACKEND=auto         # auto = use models/pretrained/nllb_600m if present | none | nllb
INDICLEARN_TRANSLATOR_MODEL=facebook/nllb-200-distilled-600M
INDICLEARN_LOCAL_FILES_ONLY=false
# IndicTrans2, Telugu Whisper, Whisper, MMS-TTS and Indic Parler-TTS are picked up from models/pretrained
# automatically. Switch any of them off with INDICLEARN_USE_MT=0, INDICLEARN_USE_TTS=0, INDICLEARN_USE_ASR=0

HOST=127.0.0.1
PORT=8000
