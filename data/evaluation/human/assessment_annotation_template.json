{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IndicLearn Adaptive Assessment Item Annotation Schema",
  "description": "Schema for evaluating item quality, difficulty alignment, and diagnostic efficacy of adaptively selected assessment items.",
  "type": "object",
  "required": [
    "annotation_id",
    "annotator_id",
    "item_id",
    "concept_id",
    "language",
    "target_difficulty",
    "scores",
    "timestamp"
  ],
  "properties": {
    "annotation_id": { "type": "string" },
    "annotator_id": { "type": "string" },
    "item_id": { "type": "string" },
    "concept_id": { "type": "string" },
    "language": {
      "type": "string",
      "enum": ["en", "te", "te-Latn", "te-en"]
    },
    "target_difficulty": {
      "type": "string",
      "enum": ["BEGINNER", "INTERMEDIATE", "ADVANCED"]
    },
    "question_text": { "type": "string" },
    "distractor_quality_notes": { "type": "string" },
    "scores": {
      "type": "object",
      "required": [
        "difficulty_calibration",
        "concept_alignment",
        "question_clarity",
        "diagnostic_value",
        "language_naturalness"
      ],
      "properties": {
        "difficulty_calibration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "1=grossly misaligned difficulty, 5=precisely calibrated to student's current proficiency"
        },
        "concept_alignment": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "1=off-topic or irrelevant, 5=directly probes the targeted academic concept"
        },
        "question_clarity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "1=ambiguous/confusing stem, 5=flawlessly unambiguous question stem"
        },
        "diagnostic_value": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "1=answers reveal nothing about student misconception, 5=distractors pinpoint precise misconception"
        },
        "language_naturalness": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "1=unnatural/machine translation artifacts, 5=authentic academic engineering phrasing"
        }
      }
    },
    "comments": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
