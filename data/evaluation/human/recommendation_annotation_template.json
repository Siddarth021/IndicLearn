{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IndicLearn Recommendation Annotation Schema",
  "description": "Schema for evaluating pedagogical quality, rationale transparency, and prioritization of learning recommendations.",
  "type": "object",
  "required": [
    "annotation_id",
    "annotator_id",
    "scenario_id",
    "student_state_summary",
    "recommendation",
    "scores",
    "timestamp"
  ],
  "properties": {
    "annotation_id": {
      "type": "string"
    },
    "annotator_id": {
      "type": "string"
    },
    "scenario_id": {
      "type": "string"
    },
    "student_state_summary": {
      "type": "object",
      "required": ["estimated_knowledge", "evidence_confidence", "target_concept"],
      "properties": {
        "estimated_knowledge": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "target_concept": { "type": "string" },
        "prerequisite_status": { "type": "string" },
        "known_gaps": { "type": "array", "items": { "type": "string" } }
      }
    },
    "recommendation": {
      "type": "object",
      "required": ["concept_id", "pedagogical_action", "priority_rank", "rationale_code"],
      "properties": {
        "concept_id": { "type": "string" },
        "pedagogical_action": {
          "type": "string",
          "enum": ["REMEDIAL_STUDY", "PREREQUISITE_REPAIR", "PRACTICE_ASSESSMENT", "ADVANCE_TOPIC", "EXPLORE_RELATED"]
        },
        "priority_rank": { "type": "integer", "minimum": 1 },
        "rationale_code": { "type": "string" }
      }
    },
    "scores": {
      "type": "object",
      "required": [
        "pedagogical_appropriateness",
        "priority_soundness",
        "rationale_clarity",
        "prerequisite_sensitivity"
      ],
      "properties": {
        "pedagogical_appropriateness": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "1=harmful/counter-productive, 5=ideal next learning step"
        },
        "priority_soundness": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "1=illogical order, 5=flawless prioritization given student state"
        },
        "rationale_clarity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "1=opaque/confusing justification, 5=crystal clear explanation of why recommended"
        },
        "prerequisite_sensitivity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "1=ignores prerequisite blocker, 5=appropriately halts progression to address foundational deficits"
        }
      }
    },
    "qualitative_assessment": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
