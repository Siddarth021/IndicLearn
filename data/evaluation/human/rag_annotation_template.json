{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IndicLearn RAG Human Annotation Schema",
  "description": "Schema for expert human annotation of generated RAG responses across grounding, factual correctness, and multilingual clarity.",
  "type": "object",
  "required": [
    "annotation_id",
    "annotator_id",
    "query_id",
    "language",
    "query_text",
    "generated_answer",
    "retrieved_evidence_ids",
    "scores",
    "timestamp"
  ],
  "properties": {
    "annotation_id": {
      "type": "string",
      "pattern": "^ANN-REC-[A-Za-z0-9_-]+$"
    },
    "annotator_id": {
      "type": "string",
      "pattern": "^ANN-[0-9]{2,4}$"
    },
    "query_id": {
      "type": "string",
      "description": "Identifier linking back to the evaluation benchmark query (e.g., Q-EN-001)"
    },
    "language": {
      "type": "string",
      "enum": ["en", "te", "te-Latn", "te-en"],
      "description": "Language or code-mixing modality of the query and response"
    },
    "concept_id": {
      "type": "string",
      "description": "Associated academic concept from the knowledge graph"
    },
    "difficulty": {
      "type": "string",
      "enum": ["BEGINNER", "INTERMEDIATE", "ADVANCED"]
    },
    "system_id": {
      "type": "string",
      "description": "System identifier or blinded code (e.g., 'SYSTEM_A', 'SYSTEM_B', or 'indiclearn_v1')"
    },
    "query_text": {
      "type": "string"
    },
    "generated_answer": {
      "type": "string"
    },
    "retrieved_evidence_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "citations": {
      "type": "array",
      "items": { "type": "string" },
      "description": "In-text citations referenced by the generated answer"
    },
    "scores": {
      "type": "object",
      "required": [
        "factual_correctness",
        "evidence_support",
        "citation_correctness",
        "pedagogical_usefulness",
        "clarity",
        "language_quality"
      ],
      "properties": {
        "factual_correctness": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "1=incorrect, 2=mostly incorrect, 3=partially correct, 4=mostly correct, 5=fully correct"
        },
        "evidence_support": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "1=unsupported, 2=weakly supported, 3=partially supported, 4=well supported, 5=fully supported"
        },
        "citation_correctness": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "1=hallucinated/irrelevant citations, 5=accurate and perfectly aligned citations"
        },
        "pedagogical_usefulness": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "1=not helpful for student learning, 5=pedagogically sound and highly instructive"
        },
        "clarity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "1=confusing/unintelligible, 5=exceptionally clear and structured"
        },
        "language_quality": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "1=unnatural/broken syntax, 5=natural, fluent, and domain-appropriate phrasing"
        },
        "code_mixed_understanding": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 5,
          "description": "Applicable only to te-Latn and te-en queries. 1=complete semantic breakdown, 5=flawless semantic capture of mixed technical jargon and Telugu grammar."
        }
      }
    },
    "comments": {
      "type": "string",
      "description": "Qualitative annotator notes on specific hallucinations, unsupported claims, or language nuances"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
