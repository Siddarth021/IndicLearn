{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AnnotatorProfileSchema",
  "description": "Pseudonymous metadata schema for human expert annotators evaluating IndicLearn.",
  "type": "object",
  "required": ["annotator_id", "primary_language", "secondary_languages", "educational_level", "engineering_background"],
  "properties": {
    "annotator_id": {
      "type": "string",
      "pattern": "^ANN_[0-9]{2,4}$",
      "description": "Pseudonymous identifier (e.g. ANN_01, ANN_02)."
    },
    "primary_language": {
      "type": "string",
      "enum": ["te", "en"],
      "description": "Native or primary language."
    },
    "secondary_languages": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Additional fluent languages (e.g. ['te', 'en'])."
    },
    "telugu_literacy": {
      "type": "string",
      "enum": ["native_script_fluent", "romanized_only", "spoken_only", "none"],
      "description": "Fluency in reading and writing Telugu script."
    },
    "educational_level": {
      "type": "string",
      "enum": ["undergraduate_student", "graduate_student", "faculty_or_researcher", "industry_engineer"],
      "description": "Highest current educational status."
    },
    "engineering_background": {
      "type": "string",
      "enum": ["ece", "eee", "cse", "it", "mechanical", "civil", "other"],
      "description": "Departmental specialization."
    },
    "familiarity_with_signals_and_systems": {
      "type": "string",
      "enum": ["expert", "proficient", "basic_coursework", "none"],
      "description": "Subject matter competence."
    }
  },
  "additionalProperties": false
}
